# Copia este archivo a .env.local y rellena tus claves de reCAPTCHA v3.
# Consíguelas en https://www.google.com/recaptcha/admin (tipo: reCAPTCHA v3)

# Clave de sitio (pública, va al navegador). El prefijo NEXT_PUBLIC_ es obligatorio.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=tu_site_key

# Clave secreta (privada, SOLO en el servidor). Nunca la pongas con NEXT_PUBLIC_.
RECAPTCHA_SECRET_KEY=tu_secret_key
